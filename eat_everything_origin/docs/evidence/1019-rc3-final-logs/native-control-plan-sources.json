          "line": 1,
          "text": "# Scope:"
        },
        {
          "line": 2,
          "text": "# this/root = planet that have been fired upon"
        },
        {
          "line": 3,
          "text": "# from = fleet that fired"
        },
        {
          "line": 4,
          "text": "#on_destroy_planet_with_PLANET_DESTRUCTION_COMPONENT = {"
        },
        {
          "line": 5,
          "text": "#\tevents = {"
        },
        {
          "line": 6,
          "text": "#\t\tplanet_destruction.1"
        },
        {
          "line": 7,
          "text": "#\t}"
        },
        {
          "line": 8,
          "text": "#}"
        },
        {
          "line": 9,
          "text": ""
        },
        {
          "line": 10,
          "text": "# Note: The _queued on_actions also fire when the command is made even if there is nothing else in the queue"
        },
        {
          "line": 11,
          "text": "# Similarly, the _unqueued on_actions fire even if you cancel the order while the weapon is on the wind-up to fire"
        },
        {
          "line": 12,
          "text": "# They use the same scopes as the standard events"
        },
        {
          "line": 13,
          "text": ""
        },
        {
          "line": 14,
          "text": "on_destroy_planet_with_PLANET_KILLER_CRACKER = {"
        },
        {
          "line": 15,
          "text": "\tevents = {"
        },
        {
          "line": 16,
          "text": "\t\ttoxoids.8016 #Destroyed knight Keep"
        },
        {
          "line": 17,
          "text": "\t\tcrisis.5015 # Menace Objective - Destroy World/Empire"
        },
        {
          "line": 18,
          "text": "\t\tplanet_destruction.110"
        },
        {
          "line": 19,
          "text": "\t\torigin.3245 # Glassing a Progenitors Nest"
        },
        {
          "line": 20,
          "text": "\t\tplanet_destruction.600 # frag holy world"
        },
        {
          "line": 21,
          "text": "\t\tplanet_destruction.100 # goes last because it can kill a country, making some trigger checks impossible"
        },
        {
          "line": 22,
          "text": "\t\tawareness.150 # Planet cracker used OR planet terraformed, chance to gain 20 awareness."
        },
        {
          "line": 23,
          "text": "\t\ttimeline.27         # Milestone First Destroyed Planet"
        },
        {
          "line": 24,
          "text": "\t}"
        }
      ]
