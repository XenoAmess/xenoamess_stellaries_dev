            "    exists = from.owner",
            "    from.owner = { eep_qualified = yes eep_core_available = yes }",
            "    from = { is_same_value = event_target:eep_mothership@owner }",
            "    is_colony = yes",
            "    exists = owner",
            "    is_artificial = no",
            "    is_under_colonization = no",
            "    has_ground_combat = no",
            "    NOT = { has_carrier_flag = eep_core }",
