      "lines": [
        {
          "line": 480,
          "text": "add_modifier - Adds a specific modifier to the scoped object for a set duration"
        },
        {
          "line": 481,
          "text": "add_modifier = {"
        },
        {
          "line": 482,
          "text": "\tmodifier = <key>"
        },
        {
          "line": 483,
          "text": "\tdays/months/years = <int, -1 (default) means it never expires>"
        },
        {
          "line": 484,
          "text": "\tmultiplier = <float>/<variable> (optional)"
        },
        {
          "line": 485,
          "text": "\ttime_multiplier = <variable> (optional: days/months/years value is multiplied by the value of this variable)"
        },
        {
          "line": 486,
          "text": "\tclear_on_owner_change = yes (optional: default no; clears modifier if planet/system/megastructure's owner changes)"
        },
        {
          "line": 487,
          "text": "}"
        },
        {
          "line": 488,
          "text": "Supported Scopes: megastructure planet country ship pop pop_group fleet galactic_object pop_faction federation starbase spy_network espionage_operation astral_rift cosmic_storm_influence_field colony"
        }
      ]
